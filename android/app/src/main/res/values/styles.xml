<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window shown while the process starts (light mode). Pre-Android-12; API 31+ picks
         up values-v31/styles.xml and the platform splash-screen API instead. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Window behind the Flutter UI once the engine has started. Matching the Dart
         surface colour is what removes the white flash on cold start. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/surface_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>

        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="21" android:startY="21"
                android:endX="87" android:endY="87"
                android:type="linear">
                <item android:offset="0" android:color="@color/brand_light" />
                <item android:offset="1" android:color="@color/brand_dark" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M40.8,41.5 L55.3,54 L40.8,66.5"
